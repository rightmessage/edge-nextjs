{
  "name": "@rightmessage/next",
  "version": "0.1.0",
  "description": "Hydration-safe personalization and server decisions for Next.js",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rightmessage/edge-nextjs.git"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@rightmessage/edge": "github:rightmessage/edge#v0.1.0"
  },
  "peerDependencies": {
    "next": ">=15.0.0 <17",
    "react": ">=19.0.0 <20",
    "react-dom": ">=19.0.0 <20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "jsdom": "^26.1.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@playwright/test": "^1.56.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
